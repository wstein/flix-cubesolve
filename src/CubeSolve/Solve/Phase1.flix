///
/// The 3x3x3 two-phase solver's first phase.
///
/// Phase one takes any cube into the subgroup generated by
/// `U, D, R2, L2, F2, B2` -- the states that can be finished without ever
/// turning a face by a quarter turn again. It is the whole reason the two-phase
/// method works: the first phase is a search over a space of two billion states
/// with a strong heuristic, and what it hands over is a much smaller problem.
///
/// **The search state is all three coordinates at once**, packed into an
/// `Int64`. `Twist x Flip x UDSlice` is 2,187 x 2,048 x 495 = 2,217,093,120,
/// which overflows `Int32` by a factor of about two -- so the search kernel is
/// parameterised by state width and this phase uses the wider one. Carrying
/// only two of the three and recovering the third would mean a heuristic that
/// could not see it.
///
/// **The heuristic is the largest of three raw pruning tables**, and taking the
/// maximum of admissible bounds is still admissible. That is what makes raw
/// tables as strong as the reference's symmetry-reduced ones: symmetry
/// compresses equivalent states, it does not change a pruning value. What
/// weakens a heuristic is a missing table, not an uncompressed one.
///
mod CubeSolve.Solve.Phase1 {

    use CubeSolve.Model.Cube
    use CubeSolve.Model.Move
    use CubeSolve.Model.Sized
    use CubeSolve.Solve.IdaStar
    use CubeSolve.Solve.IdaStar.Phase
    use CubeSolve.Table
    use CubeSolve.Table.Standard

    ///
    /// Phase one's tables.
    ///
    /// Re-exported so that a caller combining the phases talks to the phase and
    /// not to its tables: which table module a phase keeps its data in is the
    /// phase's business.
    ///
    pub type alias Tables = Standard.Tables

    ///
    /// Build phase one's tables.
    ///
    pub def buildTables(): Result[String, Tables] = Standard.build()

    ///
    /// Phase one's tables, from the cache where possible.
    ///
    pub def cachedTables(): Result[String, Tables] \ CubeSolve.Table.Cache.Store =
        Standard.cachedTables()

    ///
    /// The move with index `m` in phase one's alphabet.
    ///
    pub def moveOfIndex(m: Int32): Move.Move = Standard.moveOfIndex(m)

    ///
    /// The deepest phase one is ever allowed to search.
    ///
    /// Twelve. The reference's own bound, and comfortably above the pruning
    /// tables' maximum of 9, so the search is guided rather than blind near the
    /// end.
    ///
    pub def maxDepth(): Int32 = 12

    ///
    /// The number of phase-one states: 2,217,093,120.
    ///
    /// Reported as an `Int64` because that is the point -- it does not fit an
    /// `Int32`, which is why the search is parameterised by state width.
    ///
    pub def stateCount(): Int64 =
        Int32.toInt64(Standard.twistCount())
            * Int32.toInt64(Standard.flipCount())
            * Int32.toInt64(Standard.sliceCount())

    ///
    /// The three coordinates packed into one state.
    ///
    pub def pack(twist: Int32, flip: Int32, slice: Int32): Int64 =
        (Int32.toInt64(twist) * Int32.toInt64(Standard.flipCount())
            + Int32.toInt64(flip)) * Int32.toInt64(Standard.sliceCount())
            + Int32.toInt64(slice)

    ///
    /// The Twist coordinate of a packed state.
    ///
    pub def twistOf(s: Int64): Int32 = narrow(s / slices() / flips())

    ///
    /// The Flip coordinate of a packed state.
    ///
    pub def flipOf(s: Int64): Int32 = narrow(Int64.modulo(s / slices(), flips()))

    ///
    /// The UDSlice coordinate of a packed state.
    ///
    pub def sliceOf(s: Int64): Int32 = narrow(Int64.modulo(s, slices()))

    ///
    /// The goal: every orientation solved and the slice edges in the middle.
    ///
    pub def goal(): Int64 = pack(0, 0, Standard.solvedSlice())

    def flips(): Int64 = Int32.toInt64(Standard.flipCount())

    def slices(): Int64 = Int32.toInt64(Standard.sliceCount())

    ///
    /// A coordinate that is known to fit, as an `Int32`.
    ///
    /// Every use below has already been reduced modulo a coordinate's own size,
    /// so the narrowing cannot lose anything.
    ///
    def narrow(v: Int64): Int32 = Int64.tryToInt32(v) |> Option.getWithDefault(0)

    ///
    /// The packed phase-one state of `c`.
    ///
    pub def stateOf(c: Sized.Standard): Result[String, Int64] =
        Standard.coordsOf(Sized.cubeOfStandard(c))
            |> Result.map(match (twist, flip, slice) -> pack(twist, flip, slice))

    ///
    /// Phase one as a search phase.
    ///
    pub def phaseOf(p: Standard.Tables): Phase[Int64] =
        IdaStar.phase(
            Standard.moveCount(),
            successorOf(p),
            heuristicOf(p),
            s -> s == goal(),
            Move.htmPruningAllows
        )

    ///
    /// Where a move leads, through the three coordinate move tables.
    ///
    def successorOf(p: Standard.Tables): (Int64, Int32) -> Int64 =
        let tm = Standard.twistMoveTable(p);
        let fm = Standard.flipMoveTable(p);
        let sm = Standard.sliceMoveTable(p);
        let k = Standard.moveCount();
        (s, m) -> {
            let twist = Table.get(twistOf(s) * k + m, tm);
            let flip = Table.get(flipOf(s) * k + m, fm);
            let slice = Table.get(sliceOf(s) * k + m, sm);
            pack(twist, flip, slice)
        }

    ///
    /// The heuristic's own estimate for `state`, which is where a search starts.
    ///
    pub def heuristicAt(p: Standard.Tables, state: Int64): Int32 = (heuristicOf(p))(state)

    ///
    /// The largest of the three raw pruning bounds.
    ///
    def heuristicOf(p: Standard.Tables): Int64 -> Int32 =
        let twistSlice = Standard.twistSliceTable(p);
        let flipSlice = Standard.flipSliceTable(p);
        let flipTwist = Standard.flipTwistTable(p);
        let nSlices = Standard.sliceCount();
        let nTwists = Standard.twistCount();
        s -> {
            let twist = twistOf(s);
            let flip = flipOf(s);
            let slice = sliceOf(s);
            let a = Table.get(twist * nSlices + slice, twistSlice);
            let b = Table.get(flip * nSlices + slice, flipSlice);
            let c = Table.get(flip * nTwists + twist, flipTwist);
            Int32.max(a, Int32.max(b, c))
        }

    ///
    /// A phase-one solution for `c`: moves that take it into
    /// `<U, D, R2, L2, F2, B2>`.
    ///
    /// The result is *not* a solved cube. It is the handover to phase two, and
    /// the caller should check it with `Standard.isPhase1Solved` against the
    /// decoded model state rather than against the coordinate the search wrote.
    ///
    pub def phase1Solution(
        p: Standard.Tables,
        c: Sized.Standard
    ): Result[String, List[Move.Move]] =
        stateOf(c) |> Result.flatMap(s ->
            IdaStar.search(phaseOf(p), s, maxDepth())
                |> Result.map(f -> IdaStar.moves(f) |> List.map(Standard.moveOfIndex)))

}
