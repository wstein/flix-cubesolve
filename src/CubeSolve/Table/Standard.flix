///
/// The 3x3x3's phase-one coordinates, move tables and pruning tables.
///
/// Phase one takes any cube into the subgroup generated by
/// `U, D, R2, L2, F2, B2` -- the states from which the rest can be solved
/// without ever turning a face by a quarter. Three coordinates say whether it
/// has arrived:
///
/// ```
/// Twist     3^7  = 2187   orientation of the eight corners, seven free
/// Flip      2^11 = 2048   orientation of the twelve edges, eleven free
/// UDSlice   C(12,4) = 495 which four slots hold FR FL BL BR, unordered
/// ```
///
/// **Flip is eleven free bits, not twelve.** The edge flips sum to zero mod
/// two, so the last is forced. The same holds of Twist and the eighth corner.
///
/// **UDSlice ignores the order** of the four slice edges among themselves,
/// because phase one does not care which is which -- only that they are in the
/// middle layer. Sorting that out is phase two's problem.
///
/// The pruning tables are **raw**, not symmetry-reduced. Symmetry compresses
/// equivalent states; it does not change a pruning value. What weakens a
/// heuristic is a missing *table*, so all three pairings are built and their
/// maximum is taken, which matches the reference's strength. Reducing by
/// symmetry is then purely a memory-and-speed optimisation and is not done
/// here.
///
mod CubeSolve.Table.Standard {

    use CubeSolve.Model.Cube
    use CubeSolve.Model.Cube.Cube
    use CubeSolve.Model.Move
    use CubeSolve.Table
    use CubeSolve.Table.TableView
    use CubeSolve.Table.Standard.Phase1.Phase1
    use Orbit64.Coord.Coord.{CornerCoord, MidgeCoord}

    ///
    /// The number of corner-orientation states.
    ///
    pub def twistCount(): Int32 = 2187

    ///
    /// The number of edge-orientation states.
    ///
    pub def flipCount(): Int32 = 2048

    ///
    /// The number of positions the four slice edges can occupy, unordered.
    ///
    pub def sliceCount(): Int32 = 495

    ///
    /// The full half-turn alphabet: six faces by three amounts.
    ///
    pub def moveCount(): Int32 = 18

    ///
    /// The slice edge slots, whose occupants phase one must gather.
    ///
    /// FR, FL, BL and BR: slots 8 to 11 in the edge numbering.
    ///
    pub def sliceSlots(): Vector[Int32] = Vector#{8, 9, 10, 11}

    ///
    /// The UDSlice coordinate of a solved cube.
    ///
    /// Not zero. The coordinate is the colexicographic rank of the occupied
    /// slots, and the solved arrangement `{8, 9, 10, 11}` is the largest such
    /// set, so it ranks last.
    ///
    pub def solvedSlice(): Int32 = Orbit64.Rank.combRank(sliceSlots())

    // ---------- coordinates ----------

    ///
    /// The Twist coordinate of a corner twist vector.
    ///
    pub def twistOf(co: Vector[Int32]): Int32 =
        let digit = (acc, i) -> acc * 3 + Vector.get(i, co);
        Vector.range(0, 7) |> Vector.foldLeft(digit, 0)

    ///
    /// The eight corner twists with Twist coordinate `r`.
    ///
    pub def twistUnrank(r: Int32): Vector[Int32] = closeOver(3, 7, r)

    ///
    /// The Flip coordinate of an edge flip vector.
    ///
    pub def flipOf(eo: Vector[Int32]): Int32 =
        let digit = (acc, i) -> acc * 2 + Vector.get(i, eo);
        Vector.range(0, 11) |> Vector.foldLeft(digit, 0)

    ///
    /// The twelve edge flips with Flip coordinate `r`.
    ///
    pub def flipUnrank(r: Int32): Vector[Int32] = closeOver(2, 11, r)

    ///
    /// `free` digits of `r` in base `b`, most significant first, plus the digit
    /// the sum rule forces.
    ///
    def closeOver(b: Int32, free: Int32, r: Int32): Vector[Int32] =
        let digit = i -> Int32.modulo(r / Int32.pow(base = b, free - 1 - i), b);
        let given = Vector.init(digit, free);
        let forced = Int32.modulo(b - Int32.modulo(Vector.sum(given), b), b);
        Vector.append(given, Vector#{forced})

    ///
    /// The UDSlice coordinate of an edge permutation.
    ///
    /// Which slots hold the four slice edges, as a set. `Orbit64.Rank.combRank`
    /// is exactly Kociemba's UDSlice coordinate generalised, so this is adopted
    /// rather than restated.
    ///
    pub def sliceOf(ep: Vector[Int32]): Int32 =
        Orbit64.Rank.combRank(occupiedSlots(ep))

    ///
    /// The slots holding a slice edge, ascending.
    ///
    def occupiedSlots(ep: Vector[Int32]): Vector[Int32] =
        Vector.range(0, 12) |> Vector.filter(i -> Vector.get(i, ep) >= 8)

    ///
    /// The four slots that UDSlice coordinate `r` says are occupied.
    ///
    pub def sliceUnrank(r: Int32): Vector[Int32] = Orbit64.Rank.combUnrank(r, 4)

    ///
    /// The three phase-one coordinates of `c`, or why it has none.
    ///
    pub def coordsOf(c: Cube): Result[String, (Int32, Int32, Int32)] =
        if (Cube.size(c) != 3)
            Err("the phase-one coordinates describe a 3x3x3, not a "
                + "${Cube.size(c)}x${Cube.size(c)}x${Cube.size(c)}")
        else
            match Cube.orbits(c) {
                case CornerCoord(_, co) :: MidgeCoord(ep, eo) :: Nil =>
                    Ok((twistOf(co), flipOf(eo), sliceOf(ep)))
                case _ => Err("a 3x3x3 has a corner orbit and a midge orbit, in that order")
            }

    ///
    /// Whether `c` has reached the phase-one goal.
    ///
    /// Computed from the decoded model state, never from a search coordinate:
    /// a search bug that corrupted a coordinate would otherwise certify its own
    /// output.
    ///
    pub def isPhase1Solved(c: Cube): Bool =
        match coordsOf(c) {
            case Ok((twist, flip, slice)) =>
                twist == 0 and flip == 0 and slice == solvedSlice()
            case Err(_) => false
        }

    // ---------- move tables ----------

    ///
    /// The move table on Twist: `2187 x 18`, read at `twist * 18 + move`.
    ///
    pub def twistMoves(): Result[String, TableView] =
        movesOver(twistCount(), (r, m) -> turnedTwist(r, m))

    ///
    /// The move table on Flip: `2048 x 18`.
    ///
    pub def flipMoves(): Result[String, TableView] =
        movesOver(flipCount(), (r, m) -> turnedFlip(r, m))

    ///
    /// The move table on UDSlice: `495 x 18`.
    ///
    pub def sliceMoves(): Result[String, TableView] =
        movesOver(sliceCount(), (r, m) -> turnedSlice(r, m))

    ///
    /// A move table of `states` rows and one column per move.
    ///
    /// Sixteen bits an entry: the widest coordinate here is 2186, which does
    /// not fit a byte.
    ///
    def movesOver(states: Int32, after: (Int32, Int32) -> Int32): Result[String, TableView] =
        region rc {
            let entries = states * moveCount();
            let payload = Table.emptyPayload(rc, 16, entries);
            Vector.range(0, states) |> Vector.forEach(r ->
                Vector.range(0, moveCount()) |> Vector.forEach(m ->
                    Table.putEntry(payload, 16, r * moveCount() + m, after(r, m))));
            Table.ofPayload(16, entries, payload)
        }

    ///
    /// The Twist coordinate after move `m`.
    ///
    def turnedTwist(r: Int32, m: Int32): Int32 =
        let move = moveOfIndex(m);
        let face = Move.face(move);
        let perm = Move.cornerPermutation(face);
        let delta = Move.cornerTwist(face);
        let step = o -> Vector.init(i -> {
            let carried = Vector.get(Vector.get(i, perm), o);
            Int32.modulo(carried + Vector.get(i, delta), 3)
        }, 8);
        twistOf(repeat(Move.amount(move), twistUnrank(r), step))

    ///
    /// The Flip coordinate after move `m`.
    ///
    def turnedFlip(r: Int32, m: Int32): Int32 =
        let move = moveOfIndex(m);
        let face = Move.face(move);
        let perm = Move.edgePermutation(face);
        let delta = Move.edgeFlip(face);
        let step = o -> Vector.init(i -> {
            let carried = Vector.get(Vector.get(i, perm), o);
            Int32.modulo(carried + Vector.get(i, delta), 2)
        }, 12);
        flipOf(repeat(Move.amount(move), flipUnrank(r), step))

    ///
    /// The UDSlice coordinate after move `m`.
    ///
    /// A move carries the occupant of slot `perm[i]` into slot `i`, so the set
    /// of occupied slots becomes those `i` whose source was occupied.
    ///
    def turnedSlice(r: Int32, m: Int32): Int32 =
        let move = moveOfIndex(m);
        let perm = Move.edgePermutation(Move.face(move));
        let step = occupied -> {
            let cameFromSlice = i -> Vector.memberOf(Vector.get(i, perm), occupied);
            Vector.range(0, 12) |> Vector.filter(cameFromSlice)
        };
        Orbit64.Rank.combRank(repeat(Move.amount(move), sliceUnrank(r), step))

    ///
    /// The move with index `m`.
    ///
    pub def moveOfIndex(m: Int32): Move.Move =
        Move.ofIndex(m) |> Option.getWithDefault(Move.Move.Turn(Move.Face.U, 1))

    ///
    /// `step` applied `k` times to `x`.
    ///
    def repeat(k: Int32, x: a, step: a -> a): a =
        if (k <= 0) x else repeat(k - 1, step(x), step)

    // ---------- pruning tables ----------

    ///
    /// Every phase-one table, built together.
    ///
    pub enum Phase1 {
        case Phase1({
            twistMoves = TableView,
            flipMoves = TableView,
            sliceMoves = TableView,
            twistSlice = TableView,
            flipSlice = TableView,
            flipTwist = TableView
        })
    }

    ///
    /// The move table on Twist.
    ///
    pub def twistMoveTable(p: Phase1): TableView = let Phase1(r) = p; r#twistMoves

    ///
    /// The move table on Flip.
    ///
    pub def flipMoveTable(p: Phase1): TableView = let Phase1(r) = p; r#flipMoves

    ///
    /// The move table on UDSlice.
    ///
    pub def sliceMoveTable(p: Phase1): TableView = let Phase1(r) = p; r#sliceMoves

    ///
    /// Pruning over `Twist x UDSlice`: 1,082,565 entries.
    ///
    pub def twistSliceTable(p: Phase1): TableView = let Phase1(r) = p; r#twistSlice

    ///
    /// Pruning over `Flip x UDSlice`: 1,013,760 entries.
    ///
    pub def flipSliceTable(p: Phase1): TableView = let Phase1(r) = p; r#flipSlice

    ///
    /// Pruning over `Flip x Twist`: 4,478,976 entries, the largest of the three.
    ///
    pub def flipTwistTable(p: Phase1): TableView = let Phase1(r) = p; r#flipTwist

    ///
    /// Build every phase-one table.
    ///
    /// The three pruning sweeps are the expensive part: about 6.6 million
    /// states between them, each with eighteen successors. Pure and
    /// deterministic, so the result can be cached; nothing here does that, and
    /// a caller that needs it more than once should keep it.
    ///
    pub def build(): Result[String, Phase1] =
        forM (
            tm <- twistMoves();
            fm <- flipMoves();
            sm <- sliceMoves();
            ts <- pairPruning(
                { moves = tm, count = twistCount(), goal = 0 },
                { moves = sm, count = sliceCount(), goal = solvedSlice() });
            fs <- pairPruning(
                { moves = fm, count = flipCount(), goal = 0 },
                { moves = sm, count = sliceCount(), goal = solvedSlice() });
            ft <- pairPruning(
                { moves = fm, count = flipCount(), goal = 0 },
                { moves = tm, count = twistCount(), goal = 0 })
        ) yield Phase1({
            twistMoves = tm,
            flipMoves = fm,
            sliceMoves = sm,
            twistSlice = ts,
            flipSlice = fs,
            flipTwist = ft
        })

    ///
    /// Distance to the goal in the product of two coordinates.
    ///
    /// Four bits an entry. All three of these tables reach depth 9 and no
    /// further, which the tests check -- so fifteen stays available as the
    /// not-reached marker.
    ///
    def pairPruning(
        first: { moves = TableView, count = Int32, goal = Int32 },
        second: { moves = TableView, count = Int32, goal = Int32 }
    ): Result[String, TableView] =
        let k = moveCount();
        let firstMoves = first#moves;
        let secondMoves = second#moves;
        let secondCount = second#count;
        Table.distancesFrom(
            {
                states = first#count * secondCount,
                goal = first#goal * secondCount + second#goal,
                moves = k,
                bits = 4
            },
            (s, m) -> {
                let a = Table.get(s / secondCount * k + m, firstMoves);
                let b = Table.get(Int32.modulo(s, secondCount) * k + m, secondMoves);
                a * secondCount + b
            })

}
